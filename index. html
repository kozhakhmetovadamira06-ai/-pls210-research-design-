<script>
(function(){
  var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
  var pageNum = document.getElementById('pageNum');
  var pageTotal = document.getElementById('pageTotal');
  var progressFill = document.getElementById('progressFill');
  var prevBtn = document.getElementById('prevBtn');
  var nextBtn = document.getElementById('nextBtn');
  var idx = 0;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  pageTotal.textContent = slides.length;

  function restore(){
    try{
      var saved = localStorage.getItem('rd-mina-slide');
      if(saved !== null){
        var n = parseInt(saved, 10);
        if(n >= 0 && n < slides.length) idx = n;
      }
    }catch(e){}
  }

  function paint(){
    pageNum.textContent = String(idx + 1).padStart(2, '0');
    progressFill.style.width = (((idx + 1) / slides.length) * 100) + '%';
    try{ localStorage.setItem('rd-mina-slide', idx); }catch(e){}
  }

  function init(){
    slides.forEach(function(s, n){ s.classList.toggle('active', n === idx); });
    paint();
  }

  function go(newIdx){
    newIdx = Math.max(0, Math.min(slides.length - 1, newIdx));
    if(newIdx === idx) return;
    var dir = newIdx > idx ? 1 : -1;
    var oldSlide = slides[idx];
    var newSlide = slides[newIdx];
    idx = newIdx;

    if(reduced){
      slides.forEach(function(s,n){ s.classList.toggle('active', n===idx); });
      paint();
      return;
    }

    newSlide.classList.add('no-anim');
    newSlide.classList.remove('active','exit-left','exit-right','enter-left','enter-right');
    newSlide.classList.add(dir === 1 ? 'enter-right' : 'enter-left');
    void newSlide.offsetWidth;
    newSlide.classList.remove('no-anim');

    requestAnimationFrame(function(){
      oldSlide.classList.remove('active');
      oldSlide.classList.add(dir === 1 ? 'exit-left' : 'exit-right');
      newSlide.classList.remove('enter-right','enter-left');
      newSlide.classList.add('active');
    });

    setTimeout(function(){
      oldSlide.classList.remove('exit-left','exit-right');
    }, 620);

    paint();
  }

  prevBtn.addEventListener('click', function(){ go(idx - 1); });
  nextBtn.addEventListener('click', function(){ go(idx + 1); });

  document.addEventListener('keydown', function(e){
    if(e.key === 'ArrowRight' || e.key === ' '){ e.preventDefault(); go(idx + 1); }
    else if(e.key === 'ArrowLeft'){ e.preventDefault(); go(idx - 1); }
  });

  var touchStartX = null;
  document.addEventListener('touchstart', function(e){ touchStartX = e.touches[0].clientX; }, {passive:true});
  document.addEventListener('touchend', function(e){
    if(touchStartX === null) return;
    var dx = e.changedTouches[0].clientX - touchStartX;
    if(Math.abs(dx) > 50){ dx < 0 ? go(idx + 1) : go(idx - 1); }
    touchStartX = null;
  }, {passive:true});

  // decorative floating quotation marks — a quiet nod to "in her own words"
  if(!reduced){
    var decor = document.getElementById('decor');
    var marks = ['\u201C','\u201D','\u2018','\u2019'];
    var n = 9;
    for(var i=0;i<n;i++){
      var el = document.createElement('span');
      el.className = 'petal';
      el.textContent = marks[i % marks.length];
      el.style.left = (Math.random()*94 + 2) + 'vw';
      el.style.animationDuration = (16 + Math.random()*12) + 's';
      el.style.animationDelay = (Math.random()*-24) + 's';
      el.style.fontSize = (2 + Math.random()*2.2) + 'rem';
      decor.appendChild(el);
    }
  }

  restore();
  init();
})();
</script>
