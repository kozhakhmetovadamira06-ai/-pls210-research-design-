<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Family Expectations, Political Voice · Research Design Part 1 (mina)</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍒</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FBF2DE;
    --card:#FFFBF0;
    --ink:#1A1210;
    --ink-soft:#4B3630;
    --ink-faint:#7A6055;
    --cherry:#9E1B3C;
    --cherry-dark:#701530;
    --cherry-tint:#F6DCE2;
    --rule:#E7D6AE;
    --shadow: rgba(30,10,15,0.14);
    --focus:#9E1B3C;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --cream:#20090F; --card:#2C1119; --ink:#F7EEDD; --ink-soft:#E3C9BE;
      --ink-faint:#B78C90; --cherry:#F0879F; --cherry-dark:#C6597A; --cherry-tint:#3A1620;
      --rule:#4E2530; --shadow: rgba(0,0,0,0.4); --focus:#F0879F;
    }
  }
  :root[data-theme="dark"]{
    --cream:#20090F; --card:#2C1119; --ink:#F7EEDD; --ink-soft:#E3C9BE;
    --ink-faint:#B78C90; --cherry:#F0879F; --cherry-dark:#C6597A; --cherry-tint:#3A1620;
    --rule:#4E2530; --shadow: rgba(0,0,0,0.4); --focus:#F0879F;
  }

  *{box-sizing:border-box;}
  html{font-size:19px;}
  html,body{height:100%;}
  body{
    margin:0; background:var(--cream); color:var(--ink);
    font-family:"Newsreader", Georgia, "Times New Roman", serif;
    -webkit-font-smoothing:antialiased;
  }
  .mono{ font-family:"IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace; }
  b, strong{ font-weight:700; }

  .deck{ position:relative; height:100dvh; overflow:hidden; perspective:1600px; }

  /* cute touch: drifting quotation marks — this study is about her own words */
  .decor{ position:fixed; inset:0; pointer-events:none; z-index:2; overflow:hidden; }
  .petal{
    position:absolute; top:-14vh; font-family:Georgia, "Times New Roman", serif; font-weight:700;
    color:var(--cherry); opacity:.16; animation:drift linear infinite; will-change:transform; line-height:1;
  }
  @keyframes drift{ 0%{transform:translateY(-10vh) translateX(0) rotate(-6deg);} 100%{transform:translateY(114vh) translateX(30px) rotate(6deg);} }
  @media (prefers-reduced-motion: reduce){ .decor{ display:none; } }

  .chrome{
    position:absolute; top:0; left:0; right:0; display:flex; justify-content:space-between; align-items:center;
    padding:1.2rem clamp(1.2rem,4vw,2.5rem); font-size:0.82rem; letter-spacing:.04em; color:var(--ink-faint);
    z-index:5; pointer-events:none;
  }
  .chrome .page{color:var(--ink-soft);}
  .chrome .page b{color:var(--cherry); font-weight:700;}

  .progress{ position:absolute; top:0; left:0; right:0; height:4px; background:var(--rule); z-index:6; }
  .progress-fill{ height:100%; background:var(--cherry); width:6%; transition:width .5s ease; }

  main#slides{ position:relative; height:100%; }

  .slide{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    padding:clamp(5rem,10vw,6.5rem) clamp(1.6rem,7vw,4.5rem) clamp(3.2rem,6vw,4.5rem);
    opacity:0; pointer-events:none; overflow-y:auto; background:var(--cream);
    transform:translateX(0) rotateY(0deg);
    transition:transform .55s cubic-bezier(.22,.61,.36,1), opacity .48s ease;
    backface-visibility:hidden; transform-style:preserve-3d;
  }
  .slide.no-anim{ transition:none !important; }
  .slide.active{ opacity:1; pointer-events:auto; transform:translateX(0) rotateY(0deg); z-index:2; }
  .slide.enter-right{ opacity:0; transform:translateX(7%) rotateY(20deg); transform-origin:right center; }
  .slide.enter-left{ opacity:0; transform:translateX(-7%) rotateY(-20deg); transform-origin:left center; }
  .slide.exit-left{ opacity:0; transform:translateX(-7%) rotateY(-20deg); transform-origin:left center; }
  .slide.exit-right{ opacity:0; transform:translateX(7%) rotateY(20deg); transform-origin:right center; }
  @media (prefers-reduced-motion: reduce){
    .slide{ transition:opacity .3s ease; transform:none !important; }
  }

  .col{ max-width:720px; width:100%; margin:0 auto; }
  .col.wide{ max-width:980px; }

  .kicker{ font-family:"IBM Plex Mono", monospace; font-weight:600; font-size:.92rem; letter-spacing:.05em; color:var(--cherry); margin:0 0 1.3rem; }
  h1.big{ font-size:clamp(2.5rem,6vw,3.9rem); line-height:1.1; font-weight:600; margin:0 0 1.2rem; color:var(--ink); }
  h2{ font-size:clamp(1.8rem,3.8vw,2.4rem); line-height:1.18; font-weight:600; margin:0 0 1.4rem; color:var(--ink); }
  h3{ font-weight:600; color:var(--ink); }
  p.lede{ font-size:1.32rem; line-height:1.6; color:var(--ink-soft); margin:0 0 1.7rem; max-width:58ch; }
  .byline{ font-size:1.1rem; color:var(--ink-soft); }

  ul.notes{ list-style:none; margin:0 0 1.5rem; padding:0; }
  ul.notes li{ position:relative; padding-left:1.6rem; margin-bottom:1rem; font-size:1.24rem; line-height:1.55; color:var(--ink); }
  ul.notes li::before{ content:"—"; position:absolute; left:0; color:var(--cherry); font-weight:700; }
  ul.notes.plus li::before{content:"+"; color:var(--cherry);}
  ul.notes.dot li::before{content:"•"; color:var(--cherry);}

  ol.expect{ margin:0 0 1.5rem; padding:0; list-style:none; counter-reset:exp; }
  ol.expect li{ counter-increment:exp; position:relative; padding-left:2.4rem; margin-bottom:1.1rem; font-size:1.24rem; line-height:1.55; color:var(--ink); }
  ol.expect li::before{
    content:counter(exp); position:absolute; left:0; top:-0.06em; font-family:"IBM Plex Mono",monospace; font-weight:600;
    font-size:1rem; color:var(--cream); background:var(--cherry);
    border-radius:50%; width:1.7rem; height:1.7rem; display:flex; align-items:center; justify-content:center;
  }

  .tagline{ font-style:italic; color:var(--ink-soft); font-size:1.2rem; border-left:3px solid var(--cherry); padding-left:1.2rem; margin:1.3rem 0; }

  .cite-chip{
    display:inline-block; font-family:"IBM Plex Mono", monospace; font-weight:600; font-size:.82rem;
    color:var(--cherry); background:var(--cherry-tint); border:1.5px solid var(--cherry);
    border-radius:999px; padding:.22rem .75rem; margin:.18rem .35rem .18rem 0;
  }

  /* generic card system */
  .card-grid{ display:grid; grid-template-columns:1fr 1fr; gap:1.3rem; margin:1.5rem 0 1.6rem; }
  @media (max-width:760px){ .card-grid{grid-template-columns:1fr;} }
  .card{
    background:var(--card); border:1px solid var(--rule); border-top:5px solid var(--cherry);
    border-radius:6px; padding:1.3rem 1.4rem; box-shadow:0 8px 20px var(--shadow);
  }
  .card h3{ font-size:1.12rem; margin:0 0 .5rem; }
  .card p{ font-size:1.05rem; line-height:1.5; margin:0; color:var(--ink-soft); }
  .card .so-what{ margin-top:.7rem; padding-top:.6rem; border-top:1px dashed var(--rule); font-size:1.02rem; color:var(--cherry-dark); font-weight:600; line-height:1.45; }
  .card .so-what span{ font-weight:400; color:var(--ink-soft); }

  /* --- slide 4: comparison layout --- */
  .compare{ display:grid; grid-template-columns:1fr 1fr; gap:1.6rem; margin:1.5rem 0 1.2rem; }
  @media (max-width:760px){ .compare{grid-template-columns:1fr;} }
  .compare .box{ padding:1.4rem 1.5rem; border-radius:6px; }
  .compare .box.muted{ background:transparent; border:2px dashed var(--rule); }
  .compare .box.muted h3{ color:var(--ink-faint); }
  .compare .box.highlight{ background:var(--card); border-top:5px solid var(--cherry); border:1px solid var(--rule); border-top-width:5px; box-shadow:0 8px 20px var(--shadow); }
  .compare .box.highlight h3{ color:var(--cherry); }
  .compare h3{ font-family:"IBM Plex Mono", monospace; font-weight:600; font-size:.86rem; letter-spacing:.03em; margin:0 0 .8rem; }
  .compare p{ font-size:1.16rem; line-height:1.5; margin:0 0 .8rem; color:var(--ink); }
  .compare .small{ font-size:1rem; font-style:italic; color:var(--ink-faint); }
  .why-row{ display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin:0 0 1.4rem; }
  @media (max-width:760px){ .why-row{grid-template-columns:1fr;} }
  .why-row .mini{ background:var(--cherry-tint); border-radius:6px; padding:1rem 1.1rem; font-size:1rem; line-height:1.45; color:var(--ink-soft); }
  .why-row .mini b{ display:block; color:var(--cherry-dark); margin-bottom:.3rem; font-size:1.02rem; }

  /* --- slide 5: positioning map --- */
  .map-wrap{ display:flex; justify-content:center; margin:1.1rem 0 1.2rem; }
  .map-wrap svg{ width:100%; max-width:640px; height:auto; }
  .map-wrap text{ font-family:"IBM Plex Mono", monospace; }

  /* --- grouped literature panels (slide 7) --- */
  .funnel{ display:flex; align-items:stretch; gap:0; margin:1.5rem 0 1.2rem; }
  @media (max-width:900px){ .funnel{flex-direction:column; gap:1rem;} }
  .funnel .panel{ flex:1; background:var(--card); border:1px solid var(--rule); border-top:5px solid var(--cherry); border-radius:6px; padding:1.2rem 1.25rem; box-shadow:0 6px 16px var(--shadow); }
  .funnel .panel.gap{ background:var(--cherry); border-color:var(--cherry-dark); }
  .funnel .panel.gap h3, .funnel .panel.gap p, .funnel .panel.gap .so-what{ color:var(--cream); border-color:rgba(255,255,255,.35); }
  .funnel .panel h3{ font-size:1.05rem; margin:0 0 .5rem; }
  .funnel .panel p{ font-size:.98rem; line-height:1.45; margin:0 0 .6rem; color:var(--ink-soft); }
  .funnel .panel .so-what{ margin-top:.6rem; padding-top:.55rem; border-top:1px dashed var(--rule); font-size:.94rem; color:var(--cherry-dark); font-weight:600; line-height:1.42; }
  .funnel .panel .cite-list{ margin-top:.7rem; }
  .funnel .arrow{ display:flex; align-items:center; justify-content:center; padding:0 .4rem; color:var(--ink-faint); font-size:1.5rem; }
  @media (max-width:900px){ .funnel .arrow{ transform:rotate(90deg); padding:.1rem 0; } }

  /* --- concepts grid (slide 9) --- */
  .concepts{ display:grid; grid-template-columns:1fr 1fr; gap:1.3rem; margin:1.5rem 0 1.5rem; }
  @media (max-width:640px){ .concepts{grid-template-columns:1fr;} }

  /* --- meaning-map diagram --- */
  .diagram-wrap{ display:flex; justify-content:center; margin:1.1rem 0 1.3rem; }
  .diagram-wrap svg{ width:100%; max-width:580px; height:auto; }
  .diagram-wrap text{ font-family:"IBM Plex Mono", monospace; font-weight:600; }
  .mm-line{ fill:none; stroke:var(--cherry); stroke-opacity:.55; stroke-width:2.5; stroke-linecap:round; stroke-dasharray:340; stroke-dashoffset:340; transition:stroke-dashoffset 1.1s ease; }
  .mm-node{ opacity:0; transform:scale(.85); transform-origin:center; transition:opacity .5s ease, transform .5s ease; }
  .slide.active .mm-line{ stroke-dashoffset:0; }
  .slide.active .mm-line.l2{ transition-delay:.15s; }
  .slide.active .mm-line.l3{ transition-delay:.3s; }
  .slide.active .mm-line.l4{ transition-delay:.45s; }
  .slide.active .mm-node.n1{ opacity:1; transform:scale(1); transition-delay:1.0s; }
  .slide.active .mm-node.n2{ opacity:1; transform:scale(1); transition-delay:1.15s; }
  .slide.active .mm-node.n3{ opacity:1; transform:scale(1); transition-delay:1.3s; }
  .slide.active .mm-node.n4{ opacity:1; transform:scale(1); transition-delay:1.45s; }
  .slide.active .mm-node.center{ opacity:1; transform:scale(1); transition-delay:0s; }
  .mm-pulse{ animation:mmpulse 3s ease-in-out infinite; }
  @keyframes mmpulse{ 0%,100%{ filter:drop-shadow(0 0 0px var(--cherry)); } 50%{ filter:drop-shadow(0 0 10px var(--cherry)); } }
  @media (prefers-reduced-motion: reduce){
    .mm-line{ transition:none; stroke-dashoffset:0; } .mm-node{ transition:none; opacity:1; transform:scale(1); } .mm-pulse{ animation:none; }
  }

  /* --- personal slides --- */
  .note{ background:var(--card); border-left:5px solid var(--cherry); border-radius:0 6px 6px 0; padding:1.5rem 1.7rem; box-shadow:0 8px 20px var(--shadow); }
  .note p{ font-size:1.22rem; line-height:1.62; margin:0 0 1rem; color:var(--ink); }
  .note p:last-child{ margin-bottom:0; }

  .note-stack{ display:flex; flex-direction:column; gap:1.1rem; margin:1.4rem 0; }
  .note-chunk{ background:var(--card); border-left:5px solid var(--cherry); border-radius:0 6px 6px 0; padding:1.15rem 1.4rem; box-shadow:0 6px 16px var(--shadow); }
  .note-chunk .chunk-label{ font-family:"IBM Plex Mono", monospace; font-weight:600; font-size:.78rem; letter-spacing:.05em; color:var(--cherry); margin:0 0 .5rem; text-transform:uppercase; }
  .note-chunk p{ font-size:1.14rem; line-height:1.55; margin:0; color:var(--ink); }

  /* --- references --- */
  .refs{ columns:2; column-gap:2.2rem; margin:1.4rem 0; counter-reset:ref; }
  @media (max-width:760px){ .refs{columns:1;} }
  .refs p{ counter-increment:ref; position:relative; padding-left:1.7rem; font-size:.96rem; line-height:1.5; margin:0 0 1rem; break-inside:avoid; color:var(--ink); }
  .refs p::before{ content:counter(ref) "."; position:absolute; left:0; top:0; color:var(--cherry); font-weight:700; font-family:"IBM Plex Mono", monospace; font-size:.85rem; }
  .refs p i{ font-style:italic; }

  .closing h1.big{margin-bottom:.7rem;}
  .closing .byline{display:block; margin-top:2.2rem;}

  .controls{ position:absolute; bottom:1.2rem; right:clamp(1.2rem,4vw,2.5rem); display:flex; gap:.6rem; z-index:6; }
  .controls button{
    width:2.9rem; height:2.9rem; border-radius:50%; border:2px solid var(--cherry); background:var(--card); color:var(--cherry);
    font-size:1.2rem; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center;
    transition:background .2s ease, transform .15s ease, box-shadow .2s ease;
  }
  .controls button:hover{ background:var(--cherry); color:var(--cream); box-shadow:0 6px 16px var(--shadow); }
  .controls button:active{ transform:scale(.92); }
  .controls button:focus-visible{ outline:2px solid var(--focus); outline-offset:2px; }
</style>
